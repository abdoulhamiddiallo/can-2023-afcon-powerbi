table Metrics
	lineageTag: 42ceee94-591a-5556-9683-61b5356771b9

	/// Nombre de matchs dans le contexte
	measure 'Matchs' = COUNTROWS ( D_Match ) + 0
		formatString: 0
		lineageTag: 15494d5e-64f3-536c-8e73-c3424a380e52
		displayFolder: 01 Tournoi

	measure 'Buts' = COUNTROWS ( F_But ) + 0
		formatString: #,0
		lineageTag: 8cabdf8e-cbeb-5cc7-87dd-0ca4ec0fc6ca
		displayFolder: 01 Tournoi

	measure 'Buts par match' = DIVIDE ( [Buts], [Matchs] )
		formatString: 0.00
		lineageTag: c543917a-0974-59aa-a3c7-2244a9af0c08
		displayFolder: 01 Tournoi

	measure 'Nations' = COUNTROWS ( D_Equipe )
		formatString: 0
		lineageTag: 45b2aae8-9542-5045-a631-8667ecd414cc
		displayFolder: 01 Tournoi

	measure 'Stades' = DISTINCTCOUNT ( D_Match[StadeCode] )
		formatString: 0
		lineageTag: dc2f0673-6205-567a-92f6-96d8c3581b02
		displayFolder: 01 Tournoi

	/// Abidjan compte une seule fois (Ebimpé et Plateau)
	measure 'Villes hôtes' = CALCULATE ( DISTINCTCOUNT ( D_Stade[Ville] ), D_Stade[Ville] <> "Abidjan (Plateau)" )
		formatString: 0
		lineageTag: 86b2420e-557d-550c-8838-e26907dec961
		displayFolder: 01 Tournoi

	measure 'Spectateurs' = SUM ( D_Match[Affluence] )
		formatString: #,0
		lineageTag: 9b3f4532-9deb-502c-9fd1-f6d5fede1b20
		displayFolder: 01 Tournoi

	measure 'Affluence moyenne' = AVERAGE ( D_Match[Affluence] )
		formatString: #,0
		lineageTag: 388aa1f4-fe80-56fc-9de7-b72416a5b2e2
		displayFolder: 01 Tournoi

	measure 'Record affluence' = MAX ( D_Match[Affluence] )
		formatString: #,0
		lineageTag: 391c2d30-2720-5f59-8681-24bd361b123c
		displayFolder: 01 Tournoi

	measure 'Capacité offerte' = SUMX ( D_Match, RELATED ( D_Stade[Capacité] ) )
		formatString: #,0
		lineageTag: f39e12e2-9535-5e70-b511-65978bd6b8d1
		displayFolder: 01 Tournoi

	measure 'Taux de remplissage' = DIVIDE ( [Spectateurs], [Capacité offerte] )
		formatString: 0%
		lineageTag: f006d860-7477-5853-ab94-5c7c1cb21ebd
		displayFolder: 01 Tournoi

	/// Buts hors contre son camp, crédités au buteur
	measure 'Réalisations' = CALCULATE ( COUNTROWS ( F_But ), F_But[Type de but] <> "Contre son camp" )
		formatString: 0
		lineageTag: 452d2a7c-2b09-53b5-be4a-f0f78aca74f5
		displayFolder: 01 Tournoi

	measure 'Penalties marqués' = CALCULATE ( COUNTROWS ( F_But ), F_But[Type de but] = "Penalty" ) + 0
		formatString: 0
		lineageTag: ba406d7f-ddc7-5557-b0cf-fc68b06ca7f6
		displayFolder: 01 Tournoi

	measure 'Buts contre son camp' = CALCULATE ( COUNTROWS ( F_But ), F_But[Type de but] = "Contre son camp" ) + 0
		formatString: 0
		lineageTag: b35334ed-5cbb-580d-8d40-f1c70b680cd9
		displayFolder: 01 Tournoi

	measure 'Buts en temps additionnel' = CALCULATE ( COUNTROWS ( F_But ), F_But[Temps additionnel] = 1 ) + 0
		formatString: 0
		lineageTag: 5e8e930a-32dc-5e62-a782-088a084adda8
		displayFolder: 01 Tournoi

	measure 'Part des buts sur passe' = DIVIDE ( CALCULATE ( COUNTROWS ( F_But ), F_But[Avec passe décisive] = 1 ), [Buts] )
		formatString: 0%
		lineageTag: bf35e498-04c3-5d11-b394-dbd9e93c00bb
		displayFolder: 01 Tournoi

	measure 'Matchs nuls' = CALCULATE ( COUNTROWS ( D_Match ), D_Match[Vainqueur] = "Match nul" ) + 0
		formatString: 0
		lineageTag: c0d41549-576b-58a2-ae74-0923844e561a
		displayFolder: 01 Tournoi

	measure 'Séances de tirs au but' = CALCULATE ( COUNTROWS ( D_Match ), D_Match[Tirs au but] = 1 ) + 0
		formatString: 0
		lineageTag: 0a074750-b826-526c-b47e-af7bfe274beb
		displayFolder: 01 Tournoi

	measure 'Prolongations' = CALCULATE ( COUNTROWS ( D_Match ), D_Match[Prolongation] = 1 ) + 0
		formatString: 0
		lineageTag: 84634a4f-e11f-59ef-83c8-73c62e1c1209
		displayFolder: 01 Tournoi

	measure 'Cartons' = COUNTROWS ( F_Carton ) + 0
		formatString: 0
		lineageTag: b381be82-c849-594c-9830-905c82bf425b
		displayFolder: 01 Tournoi

	measure 'Jaunes' = CALCULATE ( COUNTROWS ( F_Carton ), F_Carton[Carton] = "Jaune" ) + 0
		formatString: 0
		lineageTag: 7d8c8e51-4904-5a39-a78d-3624adc3bec7
		displayFolder: 01 Tournoi

	measure 'Rouges' = CALCULATE ( COUNTROWS ( F_Carton ), F_Carton[Carton] = "Rouge" ) + 0
		formatString: 0
		lineageTag: 9d5787cb-98bf-593d-b4af-a70b8cc8a411
		displayFolder: 01 Tournoi

	measure 'Cartons par match' = DIVIDE ( [Cartons], [Matchs] )
		formatString: 0.0
		lineageTag: c44b5f40-41f7-5b5b-8cbe-407069dc4c80
		displayFolder: 01 Tournoi

	measure 'Interventions VAR' = COUNTROWS ( F_VAR ) + 0
		formatString: 0
		lineageTag: 1f7ec459-a51f-5c5c-b4db-44df19737638
		displayFolder: 01 Tournoi

	measure 'Remplacements' = COUNTROWS ( F_Remplacement ) + 0
		formatString: 0
		lineageTag: ddedacae-6e28-5810-8b53-b8f07e43b642
		displayFolder: 01 Tournoi

	measure 'Fautes sifflées' = SUM ( F_EquipeMatch[Fautes] )
		formatString: #,0
		lineageTag: 6a3ce280-be5b-5d3a-94f9-5b2205469ef2
		displayFolder: 01 Tournoi

	measure 'Buteurs différents' = CALCULATE ( DISTINCTCOUNT ( F_But[Buteur] ), F_But[Type de but] <> "Contre son camp" )
		formatString: 0
		lineageTag: 331414fd-995d-5ca0-bc46-b9a32426b659
		displayFolder: 01 Tournoi

	measure 'Matchs joués' = COUNTROWS ( F_EquipeMatch ) + 0
		formatString: 0
		lineageTag: c78e143e-c4a2-546f-bc4a-cb74afc67714
		displayFolder: 02 Équipes

	/// Victoires dans le temps de jeu (prolongation comprise) ; une qualification aux tirs au but compte comme un nul
	measure 'Victoires' = COUNTROWS ( FILTER ( F_EquipeMatch, F_EquipeMatch[Buts pour] > F_EquipeMatch[Buts contre] ) ) + 0
		formatString: 0
		lineageTag: fb4792b4-6bcb-543e-bde9-54a81cb6359f
		displayFolder: 02 Équipes

	measure 'Nuls' = COUNTROWS ( FILTER ( F_EquipeMatch, F_EquipeMatch[Buts pour] = F_EquipeMatch[Buts contre] ) ) + 0
		formatString: 0
		lineageTag: 7a727e12-1727-5ebd-a599-ca7c635e4951
		displayFolder: 02 Équipes

	measure 'Défaites' = COUNTROWS ( FILTER ( F_EquipeMatch, F_EquipeMatch[Buts pour] < F_EquipeMatch[Buts contre] ) ) + 0
		formatString: 0
		lineageTag: 5ffb763d-e0f9-5f42-bc71-d8391bf72662
		displayFolder: 02 Équipes

	measure 'Buts marqués' = SUM ( F_EquipeMatch[Buts pour] ) + 0
		formatString: 0
		lineageTag: c4d1ecc7-8802-55d2-82bc-fdd0fabb6272
		displayFolder: 02 Équipes

	measure 'Buts encaissés' = SUM ( F_EquipeMatch[Buts contre] ) + 0
		formatString: 0
		lineageTag: 1ce9da7d-ddb1-5010-9368-514a4f708d30
		displayFolder: 02 Équipes

	measure 'Différence de buts' = [Buts marqués] - [Buts encaissés]
		formatString: +0;-0;0
		lineageTag: be120313-2b76-5fd7-be94-0b086dd2dbf9
		displayFolder: 02 Équipes

	measure 'Points obtenus' = SUM ( F_EquipeMatch[Points] ) + 0
		formatString: 0
		lineageTag: 9098c85e-05a1-54b5-bf1c-516bef904ba5
		displayFolder: 02 Équipes

	measure 'Clean sheets' = SUM ( F_EquipeMatch[Clean sheet] ) + 0
		formatString: 0
		lineageTag: a708c26e-f817-5734-be08-cfa2ae2eb3f1
		displayFolder: 02 Équipes

	measure 'Possession moyenne' = AVERAGE ( F_EquipeMatch[Possession (%)] )
		formatString: 0" %"
		lineageTag: d452a943-eb52-5136-804d-e4778580ea1b
		displayFolder: 02 Équipes

	measure 'Tirs par match' = AVERAGE ( F_EquipeMatch[Tirs] )
		formatString: 0.0
		lineageTag: 62f6f9c5-47fc-54bd-847e-76a2b6170152
		displayFolder: 02 Équipes

	measure 'Tirs cadrés par match' = AVERAGE ( F_EquipeMatch[Tirs cadrés] )
		formatString: 0.0
		lineageTag: 9b9a24da-6757-5da2-8d90-a24e424d22e7
		displayFolder: 02 Équipes

	measure 'Précision des passes' = AVERAGE ( F_EquipeMatch[Précision des passes (%)] )
		formatString: 0" %"
		lineageTag: 803f62b7-c4bb-593b-a1f2-683618c83865
		displayFolder: 02 Équipes

	/// Drapeau de la nation en contexte
	measure 'Nation' = SELECTEDVALUE ( D_Equipe[Drapeau] )
		lineageTag: 75f49c47-d3bb-517f-a523-1347288d54ca
		displayFolder: 02 Équipes
		dataCategory: ImageUrl

	measure 'Position' = MAX ( D_Equipe[Position dans le groupe] )
		formatString: 0
		lineageTag: 88dd2542-b1ab-5252-98e3-3e780c53c5fe
		displayFolder: 02 Équipes

	measure 'Clé de classement' = MAX ( D_Equipe[Ordre du parcours] ) * 10000 - ( 3 * [Victoires] + [Nuls] ) * 100 - [Différence de buts]
		formatString: 0
		lineageTag: 3089b2cc-5697-56be-bf70-7bb5546bbe95
		displayFolder: 02 Équipes

	measure 'Rang final' = IF ( HASONEVALUE ( D_Equipe[Team_ID] ), RANKX ( ALL ( D_Equipe ), [Clé de classement], , ASC, Dense ) )
		formatString: 0
		lineageTag: 98eae280-dcfb-5ebb-ba80-201e554d5d81
		displayFolder: 02 Équipes

	measure 'Rang (moitié haute)' = IF ( [Rang final] <= 12, 1 )
		formatString: 0
		lineageTag: ad18d750-f45c-500f-8b99-d6dc43c6c891
		displayFolder: 02 Équipes

	measure 'Rang (moitié basse)' = IF ( [Rang final] > 12, 1 )
		formatString: 0
		lineageTag: 71989a29-ffb4-5ee5-9621-ba7873d6ebe2
		displayFolder: 02 Équipes

	measure 'V (groupes)' = CALCULATE ( [Victoires], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: 395efb8e-f742-5730-be3d-330c94f6b0e3
		displayFolder: 03 Groupes

	measure 'N (groupes)' = CALCULATE ( [Nuls], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: d4423599-68aa-563a-83fb-66ec3a8a9312
		displayFolder: 03 Groupes

	measure 'D (groupes)' = CALCULATE ( [Défaites], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: cea811fe-a4e4-5a6f-9dc3-0abb48449e3f
		displayFolder: 03 Groupes

	measure 'BP (groupes)' = CALCULATE ( [Buts marqués], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: 258d6404-09b7-5588-8824-567272e9c8e7
		displayFolder: 03 Groupes

	measure 'BC (groupes)' = CALCULATE ( [Buts encaissés], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: eccace8e-aed9-50aa-a499-7a25d3b3478a
		displayFolder: 03 Groupes

	measure 'Pts (groupes)' = CALCULATE ( [Points obtenus], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: 0375714c-bfa8-50f1-9767-a63eb6a2cd87
		displayFolder: 03 Groupes

	measure 'Diff (groupes)' = [BP (groupes)] - [BC (groupes)]
		formatString: +0;-0;0
		lineageTag: ef806ac7-e9d5-57a3-9907-39f0f5a66789
		displayFolder: 03 Groupes

	measure 'Rang des troisièmes' = IF ( HASONEVALUE ( D_Equipe[Team_ID] ), RANKX ( ALLSELECTED ( D_Equipe ), [Pts (groupes)] * 10000 + ( [Diff (groupes)] + 50 ) * 100 + [BP (groupes)], , DESC, Dense ) )
		formatString: 0
		lineageTag: 2f226835-34a0-58b5-b633-6956e0101491
		displayFolder: 03 Groupes

	measure 'Buts phase de groupes' = CALCULATE ( [Buts], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: a84270f6-8eb5-5cc7-8ba4-ad16fb7396be
		displayFolder: 03 Groupes

	measure 'Moyenne phase de groupes' = CALCULATE ( [Buts par match], D_Match[Phase] = "Phase de groupes" )
		formatString: 0.00
		lineageTag: 0df4b28a-3d6e-57ff-8503-03c1cfeabaf1
		displayFolder: 03 Groupes

	measure 'Nuls phase de groupes' = CALCULATE ( [Matchs nuls], D_Match[Phase] = "Phase de groupes" )
		formatString: 0
		lineageTag: b1ac392e-9008-5140-a543-fa9fbd5fbf66
		displayFolder: 03 Groupes

	measure 'Qualifiées' = CALCULATE ( COUNTROWS ( D_Equipe ), D_Equipe[Statut] = "Qualifiée" )
		formatString: 0
		lineageTag: 1b2740dc-f6c1-50c4-b7ab-4d150b5b22d9
		displayFolder: 03 Groupes

	measure 'Nation (match)' = IF ( NOT ISEMPTY ( F_EquipeMatch ), SELECTEDVALUE ( D_Equipe[Drapeau] ) )
		lineageTag: 21016448-9e47-5631-af48-7fd8e65d7adf
		displayFolder: 04 Tableau final
		dataCategory: ImageUrl

	measure 'Score (tableau)' = IF ( NOT ISEMPTY ( F_EquipeMatch ), FORMAT ( SUM ( F_EquipeMatch[Buts pour] ), "0" ) & IF ( SUM ( F_EquipeMatch[Nul puis t.a.b.] ) = 1 && SUM ( F_EquipeMatch[Victoire] ) = 1, "*", "" ) )
		lineageTag: 2299336b-a0e2-59c6-a025-02daf5ca0741
		displayFolder: 04 Tableau final

	measure 'Couleur vainqueur' = IF ( SUM ( F_EquipeMatch[Victoire] ) = 1, "#E8B84A", "#A9C4B8" )
		lineageTag: fcfd0117-c3fa-59d3-a263-352ae7f20afc
		displayFolder: 04 Tableau final

	measure 'Champion' = CALCULATE ( SELECTEDVALUE ( D_Equipe[Équipe] ), D_Equipe[Ordre du parcours] = 1 )
		lineageTag: d7a5dd61-28cb-5195-b9ea-36e2854a76aa
		displayFolder: 04 Tableau final

	measure 'Champion surnom' = CALCULATE ( SELECTEDVALUE ( D_Equipe[Surnom] ), D_Equipe[Ordre du parcours] = 1 )
		lineageTag: c23b78af-e0de-5ec3-9eae-dd5a9656bc93
		displayFolder: 04 Tableau final

	measure 'Drapeau du champion' = CALCULATE ( SELECTEDVALUE ( D_Equipe[Drapeau] ), D_Equipe[Ordre du parcours] = 1 )
		lineageTag: ddf86fff-779a-5389-b636-a76f204c9c3d
		displayFolder: 04 Tableau final
		dataCategory: ImageUrl

	measure 'Finaliste' = CALCULATE ( SELECTEDVALUE ( D_Equipe[Équipe] ), D_Equipe[Ordre du parcours] = 2 )
		lineageTag: b250078b-199f-5d06-a5e8-b6e2b856307d
		displayFolder: 04 Tableau final

	measure 'Troisième' = CALCULATE ( SELECTEDVALUE ( D_Equipe[Équipe] ), D_Equipe[Ordre du parcours] = 3 )
		lineageTag: 9d72ac78-bb07-54c2-9d60-4f76c9a16bcc
		displayFolder: 04 Tableau final

	measure 'Affiche de la finale' = CALCULATE ( SELECTEDVALUE ( D_Match[Affiche] ), D_Match[Tour] = "Finale" )
		lineageTag: 991c0525-d6f6-584e-bdde-70eea1950f65
		displayFolder: 04 Tableau final

	measure 'Ligne de la finale' = VAR code = CALCULATE ( SELECTEDVALUE ( D_Match[StadeCode] ), D_Match[Tour] = "Finale" ) RETURN CALCULATE ( SELECTEDVALUE ( D_Match[Date (texte)] ), D_Match[Tour] = "Finale" ) & " · " & LOOKUPVALUE ( D_Stade[Stade], D_Stade[StadeCode], code ) & " · " & FORMAT ( CALCULATE ( SUM ( D_Match[Affluence] ), D_Match[Tour] = "Finale" ), "#,0" ) & " spectateurs"
		lineageTag: 0b00d55b-ac49-595b-ab35-12802aca409f
		displayFolder: 04 Tableau final

	measure 'Titre du champion' = "Champion d'Afrique · " & [Champion surnom]
		lineageTag: ffb34471-8ec6-5f55-bdf5-c653cf638b2e
		displayFolder: 04 Tableau final

	measure 'Phase finale buts' = CALCULATE ( [Buts], D_Match[Phase] = "Élimination directe" )
		formatString: 0
		lineageTag: e05a68c3-f282-5024-ad3f-d7190b519757
		displayFolder: 04 Tableau final

	measure 'Phase finale matchs' = CALCULATE ( [Matchs], D_Match[Phase] = "Élimination directe" )
		formatString: 0
		lineageTag: 697288ca-5d8f-52eb-8c30-fb56b6c5d3f8
		displayFolder: 04 Tableau final

	measure 'Phase finale moyenne' = CALCULATE ( [Buts par match], D_Match[Phase] = "Élimination directe" )
		formatString: 0.00
		lineageTag: 351ae34e-38a1-5cd3-b7ee-7533e8908bc7
		displayFolder: 04 Tableau final

	measure 'Phase finale tab' = CALCULATE ( [Séances de tirs au but], D_Match[Phase] = "Élimination directe" )
		formatString: 0
		lineageTag: 078b807b-060c-5e7b-a1a8-909705f368f0
		displayFolder: 04 Tableau final

	measure 'Phase finale prolongations' = CALCULATE ( [Prolongations], D_Match[Phase] = "Élimination directe" )
		formatString: 0
		lineageTag: 38091a12-aeb1-51e7-82f6-e762b1cf941d
		displayFolder: 04 Tableau final

	/// Match sélectionné, la finale par défaut
	measure 'Match choisi' = SELECTEDVALUE ( D_Match[N° match], 52 )
		formatString: 0
		lineageTag: 770a6e9e-c835-54c2-b218-767b1c8f1bb8
		displayFolder: 05 Centre de match

	measure 'MC Domicile' = VAR sel = [Match choisi] RETURN CALCULATE ( SELECTEDVALUE ( D_Match[Domicile] ), REMOVEFILTERS ( D_Match ), D_Match[N° match] = sel )
		lineageTag: 89c4e0f8-499f-5fff-a560-3146849003ca
		displayFolder: 05 Centre de match

	measure 'MC Extérieur' = VAR sel = [Match choisi] RETURN CALCULATE ( SELECTEDVALUE ( D_Match[Extérieur] ), REMOVEFILTERS ( D_Match ), D_Match[N° match] = sel )
		lineageTag: f0d508f5-cf94-560d-8357-8729cb30c2ed
		displayFolder: 05 Centre de match

	measure 'MC Score' = VAR sel = [Match choisi] RETURN CALCULATE ( SELECTEDVALUE ( D_Match[Score] ), REMOVEFILTERS ( D_Match ), D_Match[N° match] = sel )
		lineageTag: 1577dd12-291a-5010-98db-58028b017260
		displayFolder: 05 Centre de match

	measure 'MC Tour' = VAR sel = [Match choisi] RETURN CALCULATE ( SELECTEDVALUE ( D_Match[Étiquette] ), REMOVEFILTERS ( D_Match ), D_Match[N° match] = sel )
		lineageTag: 28a45b17-8012-57c2-8c3a-b865c868ded1
		displayFolder: 05 Centre de match

	measure 'MC Drapeau domicile' = VAR sel = [Match choisi] VAR t = LOOKUPVALUE ( D_Match[DomID], D_Match[N° match], sel ) RETURN LOOKUPVALUE ( D_Equipe[Drapeau], D_Equipe[Team_ID], t )
		lineageTag: 334cee30-506d-590f-9fb9-76cb108784b8
		displayFolder: 05 Centre de match
		dataCategory: ImageUrl

	measure 'MC Drapeau extérieur' = VAR sel = [Match choisi] VAR t = LOOKUPVALUE ( D_Match[ExtID], D_Match[N° match], sel ) RETURN LOOKUPVALUE ( D_Equipe[Drapeau], D_Equipe[Team_ID], t )
		lineageTag: 76d7b2d8-a8bb-535b-9c69-ff8a7d8cdcc8
		displayFolder: 05 Centre de match
		dataCategory: ImageUrl

	measure 'MC Issue' = VAR sel = [Match choisi] VAR v = LOOKUPVALUE ( D_Match[Vainqueur], D_Match[N° match], sel ) VAR tab = LOOKUPVALUE ( D_Match[Tirs au but], D_Match[N° match], sel ) VAR ap = LOOKUPVALUE ( D_Match[Prolongation], D_Match[N° match], sel ) RETURN IF ( v = "Match nul", "Match nul", v & " l'emporte" & IF ( tab = 1, " aux tirs au but", IF ( ap = 1, " après prolongation", "" ) ) )
		lineageTag: 4038e105-01e4-5cf4-aaf4-06e282579620
		displayFolder: 05 Centre de match

	measure 'MC Infos' = VAR sel = [Match choisi] VAR code = LOOKUPVALUE ( D_Match[StadeCode], D_Match[N° match], sel ) RETURN LOOKUPVALUE ( D_Match[Date (texte)], D_Match[N° match], sel ) & " · " & LOOKUPVALUE ( D_Stade[Stade (court)], D_Stade[StadeCode], code ) & " · " & LOOKUPVALUE ( D_Stade[Ville], D_Stade[StadeCode], code )
		lineageTag: b5f2f795-90f8-5925-b0c7-584c66c7238d
		displayFolder: 05 Centre de match

	measure 'MC Spectateurs' = VAR sel = [Match choisi] RETURN LOOKUPVALUE ( D_Match[Affluence], D_Match[N° match], sel )
		formatString: #,0
		lineageTag: 96bda932-35e1-5626-9c09-fc12ad267fcb
		displayFolder: 05 Centre de match

	measure 'MC Remplissage' = VAR sel = [Match choisi] VAR code = LOOKUPVALUE ( D_Match[StadeCode], D_Match[N° match], sel ) RETURN DIVIDE ( [MC Spectateurs], LOOKUPVALUE ( D_Stade[Capacité], D_Stade[StadeCode], code ) )
		formatString: 0%
		lineageTag: 4292654c-c28c-5f4a-bb52-a16674ec1808
		displayFolder: 05 Centre de match

	measure 'MC Arbitre' = VAR sel = [Match choisi] RETURN LOOKUPVALUE ( D_Match[Arbitre], D_Match[N° match], sel ) & " (" & LOOKUPVALUE ( D_Match[Pays de l'arbitre], D_Match[N° match], sel ) & ")"
		lineageTag: 90455a19-26c0-5571-9324-636329307568
		displayFolder: 05 Centre de match

	measure 'MC Homme du match' = VAR sel = [Match choisi] RETURN LOOKUPVALUE ( D_Match[Homme du match], D_Match[N° match], sel )
		lineageTag: 9f0710d4-c739-5a48-9c46-518c3cdd09b7
