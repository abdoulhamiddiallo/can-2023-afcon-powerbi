	measure 'Couleur parcours' = SWITCH ( MAX ( D_Equipe[Ordre du parcours] ), 1, "#E8B84A", 2, "#F6F1E6", 3, "#F28C1E", 4, "#F28C1E", "#A9C4B8" )
