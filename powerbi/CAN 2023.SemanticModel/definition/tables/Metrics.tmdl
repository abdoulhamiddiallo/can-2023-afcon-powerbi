	measure 'MC VAR' = VAR sel = [Match choisi] RETURN CALCULATE ( [Interventions VAR], REMOVEFILTERS ( D_Match ), D_Match[N° match] = sel )
		formatString: 0
		lineageTag: 59baba28-8953-5003-b869-1791c47324c6
