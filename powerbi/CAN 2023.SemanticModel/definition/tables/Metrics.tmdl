	measure 'MC Cartons' = VAR sel = [Match choisi] RETURN CALCULATE ( [Cartons], REMOVEFILTERS ( D_Match ), D_Match[N° match] = sel )
		formatString: 0
		lineageTag: a1cc5555-7adc-5886-acfe-c4825cab9f18
