	measure 'Confrontation directe' = VAR a = [Choix A] VAR b = [Choix B] VAR ms = FILTER ( ALL ( D_Match ), ( D_Match[DomID] = a && D_Match[ExtID] = b ) || ( D_Match[DomID] = b && D_Match[ExtID] = a ) ) RETURN IF ( a = b, "Choisissez deux nations différentes", IF ( COUNTROWS ( ms ) = 0, "Aucune confrontation directe pendant le tournoi", CONCATENATEX ( ms, D_Match[Étiquette] & " : " & D_Match[Affiche], " · ", D_Match[N° match], ASC ) ) )
		lineageTag: a5e9ddd5-0432-52e5-b1ac-6fa535c5a04f
