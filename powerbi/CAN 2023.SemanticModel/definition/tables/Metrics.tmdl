	measure 'Valeur extérieur' = CALCULATE ( SUM ( F_Stat[Valeur] ), F_Stat[Côté] = "Extérieur" )
		formatString: 0.#
		lineageTag: 1e715424-0c94-5169-b720-2aee19a325fa
		displayFolder: 05 Centre de match

	measure 'Drapeau du but' = VAR t = SELECTEDVALUE ( F_But[Team_ID] ) RETURN IF ( NOT ISBLANK ( t ), LOOKUPVALUE ( D_Equipe[Drapeau], D_Equipe[Team_ID], t ) )
		lineageTag: b068ff62-c184-5949-a7e8-0080ad8eecca
		displayFolder: 05 Centre de match
		dataCategory: ImageUrl

	measure 'Drapeau du carton' = VAR t = SELECTEDVALUE ( F_Carton[Team_ID] ) RETURN IF ( NOT ISBLANK ( t ), LOOKUPVALUE ( D_Equipe[Drapeau], D_Equipe[Team_ID], t ) )
		lineageTag: bfb5e112-0287-5f38-9a8c-ff5249668ef2
		displayFolder: 05 Centre de match
		dataCategory: ImageUrl

	measure 'Couleur du carton' = IF ( SELECTEDVALUE ( F_Carton[Carton] ) = "Rouge", "#E5484D", "#F5C842" )
		lineageTag: fc00c991-ff3c-5cc8-90d1-2c0298d6488e
		displayFolder: 05 Centre de match

	/// Nation sélectionnée, le champion par défaut
	measure 'Équipe choisie' = SELECTEDVALUE ( D_Equipe[Team_ID], 3 )
		formatString: 0
		lineageTag: 3b89d614-5ee2-5de2-b26a-be1ea254767a
		displayFolder: 06 Parcours

	measure 'PC Nom' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( D_Equipe[Équipe] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: e93de83e-5b48-54c4-98d3-2e567ac145cc
		displayFolder: 06 Parcours

	measure 'PC Surnom' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( D_Equipe[Surnom] ) & " · " & SELECTEDVALUE ( D_Equipe[Groupe] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: e7d3f7ce-2f45-5289-9d34-b29354f13402
		displayFolder: 06 Parcours

	measure 'PC Drapeau' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( D_Equipe[Drapeau] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: 81d602a4-0541-599b-a3cf-3f7ff5974e05
		displayFolder: 06 Parcours
		dataCategory: ImageUrl

	measure 'PC Parcours' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( D_Equipe[Parcours] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: 00576192-d381-5c6e-89ff-aa6512579380
		displayFolder: 06 Parcours

	measure 'PC Matchs' = VAR sel = [Équipe choisie] RETURN CALCULATE ( [Matchs joués], REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0
		lineageTag: aa6198cf-287e-54f0-b51c-30c683609f3f
		displayFolder: 06 Parcours

	measure 'PC Bilan' = VAR sel = [Équipe choisie] RETURN CALCULATE ( FORMAT ( [Victoires], "0" ) & " V · " & FORMAT ( [Nuls], "0" ) & " N · " & FORMAT ( [Défaites], "0" ) & " D", REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: acd55554-f553-5134-8e82-533d770d6d91
		displayFolder: 06 Parcours

	measure 'PC Buts marqués' = VAR sel = [Équipe choisie] RETURN CALCULATE ( [Buts marqués], REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0
		lineageTag: fd1a1d95-ea90-5dab-b570-e98b35863aac
		displayFolder: 06 Parcours

	measure 'PC Buts encaissés' = VAR sel = [Équipe choisie] RETURN CALCULATE ( [Buts encaissés], REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0
		lineageTag: 77088f84-2704-5dba-a677-8406d5388f2e
		displayFolder: 06 Parcours

	measure 'PC Possession' = VAR sel = [Équipe choisie] RETURN CALCULATE ( [Possession moyenne], REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0" %"
		lineageTag: 0b4a3893-fefd-5062-86a9-19d512250021
		displayFolder: 06 Parcours

	measure 'PC Spectateurs' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SUMX ( F_EquipeMatch, RELATED ( D_Match[Affluence] ) ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: #,0
		lineageTag: b0b62895-9744-5ab1-be43-c9c6559f8c28
		displayFolder: 06 Parcours

	measure 'PC Cartons' = VAR sel = [Équipe choisie] RETURN CALCULATE ( [Cartons], REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0
		lineageTag: 7d6ff5ba-4ddb-54fb-ab36-e3cf63357da2
		displayFolder: 06 Parcours

	measure 'PC Réalisations' = VAR sel = [Équipe choisie] RETURN CALCULATE ( [Réalisations], REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0
		lineageTag: 64340b12-bb62-534b-b024-edae1461a956
		displayFolder: 06 Parcours

	measure 'PC Match' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( F_EquipeMatch[Match_ID] ), REMOVEFILTERS ( D_Equipe ), F_EquipeMatch[Team_ID] = sel )
		formatString: 0
		lineageTag: a2849892-08a5-5e74-88e9-2d5c822a7836
		displayFolder: 06 Parcours

	measure 'PC Visible' = IF ( NOT ISBLANK ( [PC Match] ), 1 )
		formatString: 0
		lineageTag: 03ad615f-f5dc-55e3-8637-cd6b7199f06e
		displayFolder: 06 Parcours

	measure 'PC Date' = VAR mt = [PC Match] RETURN IF ( NOT ISBLANK ( mt ), LOOKUPVALUE ( D_Match[Jour], D_Match[N° match], mt ) )
		lineageTag: deb36417-9118-52eb-82a8-3130cf8f470b
		displayFolder: 06 Parcours

	measure 'PC Nation adverse' = VAR sel = [Équipe choisie] VAR a = CALCULATE ( SELECTEDVALUE ( F_EquipeMatch[AdvID] ), REMOVEFILTERS ( D_Equipe ), F_EquipeMatch[Team_ID] = sel ) RETURN IF ( NOT ISBLANK ( a ), LOOKUPVALUE ( D_Equipe[Drapeau], D_Equipe[Team_ID], a ) )
		lineageTag: 1e9a608f-8ec8-5214-a1af-8093a2d6ad8b
		displayFolder: 06 Parcours
		dataCategory: ImageUrl

	measure 'PC Adversaire' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( F_EquipeMatch[Adversaire] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: 160e7c4e-a649-5181-bd1c-a263a764094b
		displayFolder: 06 Parcours

	measure 'PC Score' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( F_EquipeMatch[Score équipe] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: 0af40b6a-0590-5fd6-9c5d-be1eb3a73492
		displayFolder: 06 Parcours

	measure 'PC Résultat' = VAR sel = [Équipe choisie] RETURN CALCULATE ( SELECTEDVALUE ( F_EquipeMatch[Résultat] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		lineageTag: 2247cc0d-6635-54bb-9664-8060309ff62e
		displayFolder: 06 Parcours

	measure 'PC Couleur résultat' = VAR r = [PC Résultat] RETURN SWITCH ( TRUE (), LEFT ( r, 8 ) = "Victoire", "#2FBF71", LEFT ( r, 7 ) = "Défaite", "#E5484D", "#E8B84A" )
		lineageTag: 39506b66-c19b-5c4a-94e7-ac8944566c20
		displayFolder: 06 Parcours

	measure 'PC Stade' = VAR mt = [PC Match] VAR code = LOOKUPVALUE ( D_Match[StadeCode], D_Match[N° match], mt ) RETURN IF ( NOT ISBLANK ( mt ), LOOKUPVALUE ( D_Stade[Stade (court)], D_Stade[StadeCode], code ) )
		lineageTag: d1c9079f-aae4-51e7-90ec-d38def1aa982
		displayFolder: 06 Parcours

	measure 'PC Affluence' = VAR mt = [PC Match] RETURN IF ( NOT ISBLANK ( mt ), LOOKUPVALUE ( D_Match[Affluence], D_Match[N° match], mt ) )
		formatString: #,0
		lineageTag: 8426ebeb-a047-5a22-8b20-f99406c1c7da
		displayFolder: 06 Parcours

	measure 'PC Homme du match' = VAR mt = [PC Match] RETURN IF ( NOT ISBLANK ( mt ), LOOKUPVALUE ( D_Match[Homme du match], D_Match[N° match], mt ) )
		lineageTag: 813c5f01-fe43-5176-b82d-ad624d8d3729
		displayFolder: 06 Parcours

	measure 'PC Moyenne équipe' = VAR sel = [Équipe choisie] RETURN CALCULATE ( AVERAGE ( F_Stat[Valeur] ), REMOVEFILTERS ( D_Equipe ), D_Equipe[Team_ID] = sel )
		formatString: 0.0
		lineageTag: 1d56e399-723c-5b5a-9d9d-c344d9442b56
		displayFolder: 06 Parcours

	measure 'Moyenne CAN' = CALCULATE ( AVERAGE ( F_Stat[Valeur] ), REMOVEFILTERS ( D_Equipe ) )
		formatString: 0.0
		lineageTag: ce867841-0c85-59a8-bb58-4d8498afeac4
		displayFolder: 06 Parcours

	measure 'PC Écart' = DIVIDE ( [PC Moyenne équipe] - [Moyenne CAN], [Moyenne CAN] )
		formatString: +0%;-0%;0%
		lineageTag: 022b4b39-c57c-56be-a5b5-7cf2bdf5bf3d
		displayFolder: 06 Parcours

	measure 'PC Couleur écart' = VAR e = [PC Écart] VAR inv = SELECTEDVALUE ( F_Stat[Statistique] ) IN { "Fautes", "Hors-jeu", "Cartons jaunes", "Cartons rouges" } VAR bon = IF ( inv, e < 0, e > 0 ) RETURN IF ( ABS ( e ) < 0.02, "#A9C4B8", IF ( bon, "#2FBF71", "#E5484D" ) )
		lineageTag: a5dfcd01-694e-5eab-b96b-fabe5e819783
		displayFolder: 06 Parcours

	measure 'Buteurs (3 buts et plus)' = IF ( [Réalisations] >= 3, [Réalisations] )
		formatString: 0
		lineageTag: 61a4278b-51e3-5d2b-9258-3f2fcf0df8af
		displayFolder: 07 Buteurs

	measure 'Meilleur buteur' = VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( F_But[Buteur] ), "@b", [Réalisations] ), [@b], DESC ) RETURN MAXX ( t, F_But[Buteur] )
		lineageTag: ba462172-36e8-582d-a9ff-8a52b24c56b9
		displayFolder: 07 Buteurs

	measure 'Meilleur buteur ligne' = VAR nom = [Meilleur buteur] VAR b = MAXX ( VALUES ( F_But[Buteur] ), [Réalisations] ) VAR t = CALCULATE ( MAX ( F_But[Team_ID] ), F_But[Buteur] = nom ) RETURN FORMAT ( b, "0" ) & " buts · " & LOOKUPVALUE ( D_Equipe[Équipe], D_Equipe[Team_ID], t )
		lineageTag: 3121dfdf-1e6d-548b-b6a8-70d854f285df
		displayFolder: 07 Buteurs

	measure 'But le plus rapide' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], ASC ) RETURN MAXX ( t, F_But[Minute (texte)] )
		lineageTag: 22e55f0f-4d4b-590c-86f6-7fd1e946c824
		displayFolder: 07 Buteurs

	measure 'But le plus rapide ligne' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], ASC ) VAR mt = MAXX ( t, F_But[Match_ID] ) RETURN MAXX ( t, F_But[Buteur] ) & " · " & LOOKUPVALUE ( D_Match[Affiche], D_Match[N° match], mt )
		lineageTag: 32012f8c-356b-551b-a52c-cacb1f03c5de
		displayFolder: 07 Buteurs

	measure 'But le plus tardif' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], DESC ) RETURN MAXX ( t, F_But[Minute (texte)] )
		lineageTag: bd06073c-d525-5705-9885-9da4812f1390
		displayFolder: 07 Buteurs

	measure 'But le plus tardif ligne' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], DESC ) VAR mt = MAXX ( t, F_But[Match_ID] ) RETURN MAXX ( t, F_But[Buteur] ) & " · " & LOOKUPVALUE ( D_Match[Affiche], D_Match[N° match], mt )
		lineageTag: 1b4071b6-46fc-5371-8346-bd1522a377c0
		displayFolder: 07 Buteurs

	measure 'But le plus rapide buteur' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], ASC ) RETURN MAXX ( t, F_But[Buteur (équipe)] )
		lineageTag: f427baeb-39ce-5125-a3e4-c8d0a65c9e72
		displayFolder: 07 Buteurs

	measure 'But le plus rapide match' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], ASC ) RETURN LOOKUPVALUE ( D_Match[Affiche (courte)], D_Match[N° match], MAXX ( t, F_But[Match_ID] ) )
		lineageTag: 0e129384-5e0a-5399-bd24-c30f644ffa53
		displayFolder: 07 Buteurs

	measure 'But le plus tardif buteur' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], DESC ) RETURN MAXX ( t, F_But[Buteur (équipe)] )
		lineageTag: 9546e3ce-d358-5b56-aa8d-94c9876322f4
		displayFolder: 07 Buteurs

	measure 'But le plus tardif match' = VAR t = TOPN ( 1, F_But, F_But[Tri minute], DESC ) RETURN LOOKUPVALUE ( D_Match[Affiche (courte)], D_Match[N° match], MAXX ( t, F_But[Match_ID] ) )
		lineageTag: cb8432ca-f3e7-5c62-81cf-e0a9fea7f66c
		displayFolder: 07 Buteurs

	measure 'Plus large victoire 1' = VAR mx = MAX ( D_Match[Écart] ) VAR t = TOPN ( 1, FILTER ( D_Match, D_Match[Écart] = mx ), D_Match[N° match], ASC ) RETURN MAXX ( t, D_Match[Affiche (courte)] )
		lineageTag: 0779a321-0feb-5c7c-b6ed-11f5c5331ad1
		displayFolder: 07 Buteurs

	measure 'Plus large victoire 2' = VAR mx = MAX ( D_Match[Écart] ) VAR t = TOPN ( 1, FILTER ( D_Match, D_Match[Écart] = mx ), D_Match[N° match], DESC ) VAR a = MAXX ( t, D_Match[Affiche (courte)] ) RETURN IF ( a = [Plus large victoire 1], " ", a )
		lineageTag: 9e4d9062-a966-5d88-ab2a-783e65075a53
		displayFolder: 07 Buteurs

	measure 'Plus large écart' = MAX ( D_Match[Écart] )
		formatString: 0
		lineageTag: 7d724ca6-e465-5e0f-8954-abf6cb5b7036
		displayFolder: 07 Buteurs

	measure 'Plus large victoire' = VAR mx = MAX ( D_Match[Écart] ) RETURN "+" & FORMAT ( mx, "0" )
		lineageTag: 889f1cbb-ccd7-5b92-b21e-566467d0f7bf
		displayFolder: 07 Buteurs

	measure 'Plus large victoire ligne' = VAR mx = MAX ( D_Match[Écart] ) RETURN CONCATENATEX ( FILTER ( D_Match, D_Match[Écart] = mx ), D_Match[Affiche], " · ", D_Match[N° match], ASC )
		lineageTag: c6be4abf-8e52-5d43-8f5f-9fae62f0b8ed
		displayFolder: 07 Buteurs

	measure 'Équipes les plus prolifiques' = IF ( RANKX ( ALLSELECTED ( D_Equipe[Équipe] ), [Buts marqués], , DESC, Dense ) <= 6, [Buts marqués] )
		formatString: 0
		lineageTag: 57ccf65a-b5ba-5ee6-afa9-45f492eb8b0e
		displayFolder: 07 Buteurs

	measure 'Record affluence ligne' = VAR mx = MAX ( D_Match[Affluence] ) RETURN MAXX ( FILTER ( D_Match, D_Match[Affluence] = mx ), D_Match[Étiquette] & " · " & D_Match[Affiche] )
		lineageTag: 5b9da0dd-c791-5479-b171-07264177a738
		displayFolder: 08 Stades

	measure 'Capacité totale' = SUM ( D_Stade[Capacité] )
		formatString: #,0
		lineageTag: 5b5354e7-9eed-5762-9b27-cebda6d17a28
		displayFolder: 08 Stades

	measure 'Arbitre à 3 matchs ou plus' = IF ( CALCULATE ( [Matchs], REMOVEFILTERS ( D_Match[Phase] ) ) >= 3 && [Matchs] > 0, 1 )
		formatString: 0
		lineageTag: 8c9c208d-d410-50a7-a5b0-ec1bab0fc88f
		displayFolder: 09 Discipline

	measure 'Cartons par match (arbitre)' = DIVIDE ( [Cartons], [Matchs] )
		formatString: 0.0
		lineageTag: fc2210a1-7141-53b7-969a-fafa0f59b304
		displayFolder: 09 Discipline

	measure 'Spectateurs (M)' = DIVIDE ( [Spectateurs], 1000000 )
		formatString: 0.00" M"
		lineageTag: b8ea8360-4573-5844-a204-23066f85ffb5
		displayFolder: 01 Tournoi

	measure 'Bilan' = FORMAT ( [Victoires], "0" ) & " - " & FORMAT ( [Nuls], "0" ) & " - " & FORMAT ( [Défaites], "0" )
		lineageTag: 56581aac-ff3d-57fe-b90b-454dfcfaf3ed
		displayFolder: 02 Équipes

	measure 'Sous-titre buts' = FORMAT ( [Penalties marqués], "0" ) & " penalties · " & FORMAT ( [Buts contre son camp], "0" ) & " csc"
		lineageTag: 3ed27e07-a819-5bc0-994c-0784494b4b55
		displayFolder: 01 Tournoi

	measure 'Type court' = SWITCH ( SELECTEDVALUE ( F_But[Type de but] ), "Penalty", "pen.", "Contre son camp", "csc", "" )
		lineageTag: 393d8cf7-6364-5cd9-a40e-265ef6d61a5b
		displayFolder: 05 Centre de match

	measure 'But du match choisi' = IF ( MAX ( F_But[Match_ID] ) = [Match choisi], 1 )
		formatString: 0
		lineageTag: 5ba3262a-0634-591c-9569-47243bd36455
		displayFolder: 05 Centre de match

	measure 'Carton du match choisi' = IF ( MAX ( F_Carton[Match_ID] ) = [Match choisi], 1 )
		formatString: 0
		lineageTag: e36136d4-1195-552f-aa56-d1e7df7c439f
		displayFolder: 05 Centre de match

	measure 'Duel domicile' = VAR sel = [Match choisi] RETURN CALCULATE ( SUM ( F_Stat[Valeur] ), REMOVEFILTERS ( D_Match ), F_Stat[Match_ID] = sel, F_Stat[Côté] = "Domicile" )
		formatString: 0.#
		lineageTag: 21f209f1-2ed2-5be5-862c-844eedd52c2b
		displayFolder: 05 Centre de match

	measure 'Duel extérieur' = VAR sel = [Match choisi] RETURN CALCULATE ( SUM ( F_Stat[Valeur] ), REMOVEFILTERS ( D_Match ), F_Stat[Match_ID] = sel, F_Stat[Côté] = "Extérieur" )
		formatString: 0.#
		lineageTag: 425c8176-293c-5b2c-8045-263c75492bd3
		displayFolder: 05 Centre de match

	measure 'Spectateurs par match (stade)' = DIVIDE ( [Spectateurs], [Matchs] )
		formatString: #,0
		lineageTag: 12319c50-b58f-547c-8f27-79459fa39023
		displayFolder: 08 Stades

	measure 'Stades et villes' = FORMAT ( [Stades], "0" ) & " / " & FORMAT ( [Villes hôtes], "0" )
		lineageTag: 13270c2b-7cce-5d75-be7e-ff6697ff74a2
		displayFolder: 08 Stades

	measure 'Rang cartons' = IF ( HASONEVALUE ( D_Equipe[Team_ID] ), RANKX ( ALL ( D_Equipe ), [Cartons] * 100 + MAX ( D_Equipe[Team_ID] ), , DESC ) )
		formatString: 0
		lineageTag: d4fb078e-b073-5e56-8728-e640a01f81ff
		displayFolder: 09 Discipline

	measure 'Jaunes (top 12)' = IF ( [Rang cartons] <= 12, [Jaunes] )
		formatString: 0
		lineageTag: fc7abc43-afd3-561e-8f7f-a094c69eb0f5
		displayFolder: 09 Discipline

	measure 'Rouges (top 12)' = IF ( [Rang cartons] <= 12, [Rouges] )
		formatString: 0
		lineageTag: 2c8bd6bb-8a63-53ea-b15f-3512797ffc09
		displayFolder: 09 Discipline

	measure 'Rang affluence' = IF ( HASONEVALUE ( D_Match[N° match] ), RANKX ( ALL ( D_Match ), CALCULATE ( SUM ( D_Match[Affluence] ) ), , DESC ) )
		formatString: 0
		lineageTag: 9ba626a3-d3fa-5e09-b05f-24caa26c6a4b
		displayFolder: 08 Stades

	measure 'Jours de match' = DISTINCTCOUNT ( D_Match[Date] )
		formatString: 0
		lineageTag: ddb341cd-04f8-556a-8099-e8d501d50f52
		displayFolder: 11 Fil du tournoi

	measure 'Buts par jour de match' = DIVIDE ( [Buts], [Jours de match] )
		formatString: 0.0
		lineageTag: f7e6df7a-b26d-5a3f-9592-61f710951fb7
		displayFolder: 11 Fil du tournoi

	measure 'Buts cumulés' = VAR d = MAX ( D_Match[Date] ) RETURN CALCULATE ( [Buts], FILTER ( ALL ( D_Match ), D_Match[Date] <= d ) )
		formatString: 0
		lineageTag: 4a33b1c2-1494-5d2e-b14a-698542f3e27c
		displayFolder: 11 Fil du tournoi

	measure 'Spectateurs cumulés (M)' = VAR d = MAX ( D_Match[Date] ) RETURN CALCULATE ( DIVIDE ( [Spectateurs], 1000000 ), FILTER ( ALL ( D_Match ), D_Match[Date] <= d ) )
		formatString: 0.00" M"
		lineageTag: 9d62df2c-6e9e-5880-9c4d-7fc1805f9fab
		displayFolder: 11 Fil du tournoi

	measure 'Journée record' = VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( D_Match[Date] ), "@b", [Buts] ), [@b], DESC, D_Match[Date], ASC ) RETURN FORMAT ( MAXX ( t, [@b] ), "0" ) & " buts"
		lineageTag: 520ec4bf-9064-5683-b44a-732d97f5455e
		displayFolder: 11 Fil du tournoi

	measure 'Journée record ligne' = VAR t = TOPN ( 1, ADDCOLUMNS ( VALUES ( D_Match[Date] ), "@b", [Buts] ), [@b], DESC, D_Match[Date], ASC ) VAR d = MAXX ( t, D_Match[Date] ) RETURN "le " & FORMAT ( d, "d mmmm" )
		lineageTag: 7cbcb0a0-3165-5f2c-a57b-baf51ce6f339
		displayFolder: 11 Fil du tournoi

	measure 'Match le plus prolifique' = MAX ( D_Match[Buts du match] )
		formatString: 0
		lineageTag: 9fd6be50-e8e9-5306-938a-9b6631597c99
		displayFolder: 11 Fil du tournoi

	measure 'Match le plus prolifique ligne' = VAR mx = MAX ( D_Match[Buts du match] ) RETURN MAXX ( TOPN ( 1, FILTER ( D_Match, D_Match[Buts du match] = mx ), D_Match[N° match], ASC ), D_Match[Affiche (courte)] )
		lineageTag: 7f97b445-7a1f-5481-b874-3fe3637e8dab
		displayFolder: 11 Fil du tournoi

	measure 'Rang prolifique' = IF ( HASONEVALUE ( D_Match[N° match] ), RANKX ( ALL ( D_Match ), CALCULATE ( MAX ( D_Match[Buts du match] ) ) * 100 - CALCULATE ( MAX ( D_Match[N° match] ) ), , DESC ) )
		formatString: 0
		lineageTag: b22801c1-4dc4-5a03-a960-5cf9f05dc59c
		displayFolder: 11 Fil du tournoi

	measure 'Matchs sans but' = CALCULATE ( COUNTROWS ( D_Match ), D_Match[Buts du match] = 0 ) + 0
		formatString: 0
		lineageTag: e1b9e43a-5065-5bcd-940c-aa3a08feb181
		displayFolder: 11 Fil du tournoi

