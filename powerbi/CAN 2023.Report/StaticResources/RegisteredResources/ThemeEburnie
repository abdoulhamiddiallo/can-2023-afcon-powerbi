        "visualHeader": [
          {
            "show": false
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#063629"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#F6F1E6"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#245E4A"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#0B3A2D"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#F6F1E6"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#245E4A"
              }
            }
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#063629"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#C2D6CC"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#245E4A"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#063629"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#021A14"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F6F1E6"
              }
            },
            "background": {
              "solid": {
                "color": "#082E24"
              }
            },
            "outline": "None",
            "fontSize": 13
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#F28C1E"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
