    "largeTitle": {
      "fontFace": "DIN",
      "fontSize": 30,
      "color": "#F6F1E6"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0B3A2D"
              }
